env = SHELL=/run/current-system/sw/bin/fish
command = /run/current-system/sw/bin/fish --login --init-command "tmux new-session -A -s main"

scrollback-limit = 0
mouse-hide-while-typing = true
copy-on-select = clipboard

confirm-close-surface = false
quit-after-last-window-closed = true

maximize = true
window-decoration = none
window-padding-x = 0
window-padding-y = 0

font-family = PragmataPro Mono
font-style = Regular
font-size = 16

background = #000000
foreground = #b9b9b9

# tmux: new window
keybind = cmd+t=text:\x01c
# tmux: close window
keybind = cmd+w=text:\x01x
# tmux: zoom window
keybind = cmd+z=text:\x01z
# tmux: switch window
keybind = cmd+p=text:\x01w
# nvim: write buffer
keybind = cmd+s=text:\x1b:w\n
keybind = cmd+d=text:darkmode\n

config-file = ?config.local
